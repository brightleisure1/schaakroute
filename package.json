{
  "name": "schaakroute",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4179 --strictPort",
    "data:games": "node scripts/sample-games.mjs 2026-09 40 8",
    "data:import": "node scripts/import-openings.mjs",
    "data:puzzles": "node scripts/import-puzzles.mjs",
    "data:curated": "node scripts/add-curated-openings.mjs",
    "data:all": "npm run data:import && npm run data:puzzles && npm run data:curated",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "data:fetch-puzzles": "curl -L -o data-raw/lichess_db_puzzle.csv.zst https://database.lichess.org/lichess_db_puzzle.csv.zst"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "stockfish": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
